# 复制为 ~/.config/eagle-icloud-photos-import/config.env

# API 直拉（不使用 Dropbox 本地 CloudStorage 目录）
DROPBOX_PULL_ENABLED=true
DROPBOX_STAGING_REMOTE="/Share/iCloud-Inbox"
DOWNLOAD_DIR="$HOME/.eagle-sync/staging-inbox"

DROPBOX_APP_KEY=""
DROPBOX_APP_SECRET=""
DROPBOX_REFRESH_TOKEN=""

PHOTOS_ALBUM="生活"

STATE_FILE="$HOME/.eagle-sync/photos-import-state.json"
LOG_FILE="$HOME/Library/Logs/eagle-icloud-photos-import.log"
